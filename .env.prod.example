# Used with: docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# Public URL of the nginx UI (also sets FRONTEND_URL / CORS / APP_PUBLIC_URL).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# DB / MinIO (change on a real VPS)
POSTGRES_PASSWORD=mood
MINIO_ROOT_USER=mood
MINIO_ROOT_PASSWORD=moodsecret

# Mail: for local prod-smoke use profile `mail` + MailHog defaults.
# On VPS set a real SMTP and omit --profile mail.
SMTP_HOST=mailhog
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
