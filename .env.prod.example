# Used with: docker compose -f docker-compose.prod.yml --env-file .env.prod up --build

# Public URL of the nginx UI (also sets FRONTEND_URL / CORS / APP_PUBLIC_URL).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# External Postgres (Neon). postgresql:// is rewritten to the psycopg 3 driver.
# Use the direct host for migrations (no "-pooler" in the hostname).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/mood_tracker?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/mood_tracker?sslmode=require

# MinIO (still a container in this compose file)
MINIO_ROOT_USER=mood
MINIO_ROOT_PASSWORD=moodsecret

# Mail: for local prod-smoke use profile `mail` + MailHog defaults.
# On VPS set a real SMTP and omit --profile mail.
SMTP_HOST=mailhog
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
