# Application
APP_DEBUG=false
APP_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# localhost and 127.0.0.1 are different CORS origins (WSL / Firefox often use the latter).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (used by app and Alembic)
# Local Docker Compose overrides DATABASE_URL to host "db".
# For local make migrate/test against that Postgres, use localhost and POSTGRES_PORT from ../.env.
# postgresql:// and postgres:// are rewritten to postgresql+psycopg:// (psycopg 3).
# On Render, set DATABASE_URL to Neon. Alembic prefers DATABASE_URL_UNPOOLED (direct host, no "-pooler").
DATABASE_URL=postgresql+psycopg://mood:mood@db:5432/mood_tracker
DATABASE_URL_UNPOOLED=
# Dedicated test database — pytest and migration stairway tests ONLY use this URL.
# Name must end with "_test" and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://mood:mood@localhost:5432/mood_tracker_test
DB_TABLE_PREFIX=mt_

# Object storage (S3-compatible). Local Compose overrides the endpoint to the minio container.
# For local dev against that MinIO, use localhost and MINIO_API_PORT from ../.env.
# On Render / prod Compose, set these to the hosted service (MINIO_SECURE=true for HTTPS).
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mood
MINIO_SECRET_KEY=moodsecret
MINIO_BUCKET=mood-tracker
MINIO_SECURE=false

# Auth / JWT
JWT_SECRET_KEY=dev-only-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_TOKEN_EXPIRE_HOURS=24

# Google OAuth (leave empty to disable redirect flow in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Telegram browser login (BotFather → Login Widget → OpenID Connect).
# Allowed URLs must include this redirect URI. Leave empty to hide the working flow (button still 503s).
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/telegram/callback

# Email (MailHog in Docker Compose)
# In Docker: SMTP_HOST=mailhog. For local dev against compose mailhog, use localhost and MAILHOG_SMTP_PORT from ../.env
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mood-tracker.local

# Reminder worker (daily mood + goal notifications)
# Set NOTIFICATIONS_WORKER_ENABLED=false to pause sending without stopping the container
# Global kill switch. false = reminders are not sent and the settings UI is locked.
FEATURE_NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_WORKER_ENABLED=true
# How often the worker checks for due reminders (seconds)
NOTIFICATIONS_POLL_INTERVAL_SECONDS=60
# Send a reminder if local time is within this many minutes after the user's chosen time
NOTIFICATIONS_MATCH_WINDOW_MINUTES=2

# Tag groups pinned to the entry form (rest available under "Other")
ENTRY_VISIBLE_TAG_GROUP_LIMIT=6
# Goals pinned to the entry form (rest available under "Other")
ENTRY_VISIBLE_GOAL_LIMIT=3
# Goals shown in calendar and period stats
STATS_VISIBLE_GOAL_LIMIT=5

# Weekly frequent-tag shortcuts on the entry form (bias-sensitive; default off).
# TODO: move to a DB table so toggling does not require restarting the server.
# Master kill switch. false = nobody sees the section, including allowlists.
FEATURE_WEEKLY_FREQUENT_TAGS=false
# Percent of users (stable hash of user id). 0 = only allowlists, 100 = everyone.
FEATURE_WEEKLY_FREQUENT_TAGS_PERCENT=0
# Comma-separated emails always in when the master switch is on.
FEATURE_WEEKLY_FREQUENT_TAGS_EMAILS=
# Comma-separated user UUIDs always in when the master switch is on.
FEATURE_WEEKLY_FREQUENT_TAGS_USER_IDS=
# How many shortcuts to show, and lookback window in local calendar days.
FEATURE_WEEKLY_FREQUENT_TAGS_LIMIT=8
FEATURE_WEEKLY_FREQUENT_TAGS_DAYS=7

# Guest local diary experiment (default off — login wall unchanged).
FEATURE_GUEST_LOCAL_DIARY=false
FEATURE_GUEST_LOCAL_DIARY_PERCENT=0
FEATURE_GUEST_LOCAL_DIARY_VISITOR_IDS=
GUEST_EXPERIMENT_SECRET=dev-only-guest-experiment-secret-change-me

# Telegram bot (leave token empty to disable notifier / skip setWebhook locally)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret for telegram-bot → API (/v1/telegram/bot/*). Generate a random string for local use.
TELEGRAM_BOT_SERVICE_TOKEN=dev-telegram-bot-service-token
TELEGRAM_LINK_CODE_EXPIRE_MINUTES=15
# Mini App initData is rejected after this many seconds (replay protection).
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Webhook (used by telegram-bot container)
TELEGRAM_WEBHOOK_SECRET=dev-telegram-webhook-secret
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Public HTTPS URL of the Mini App (same as FRONTEND_URL when that origin is HTTPS).
TELEGRAM_MINI_APP_URL=

# Billing / subscriptions. fake settles checkout in-process (local + tests).
# Switch to stripe,sber when those adapters are wired and keys are set.
BILLING_CURRENCY=RUB
BILLING_DEFAULT_PROVIDER=fake
BILLING_ENABLED_PROVIDERS=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SBER_USERNAME=
SBER_PASSWORD=

# Local ONNX model for semantic search (notes and voice transcriptions).
# false = do not download or load the model. Render image defaults to false.
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMS=384
# Max cosine distance (0 identical, 1 orthogonal). Results farther than this are dropped.
EMBEDDING_SEARCH_MAX_DISTANCE=0.5
