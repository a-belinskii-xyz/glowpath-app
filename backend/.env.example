# Application
APP_DEBUG=false

# Database (used by app and Alembic)
# In Docker: host is "db". For local dev against compose db, use localhost and POSTGRES_PORT from ../.env
DATABASE_URL=postgresql+psycopg://mood:mood@db:5432/mood_tracker
DB_TABLE_PREFIX=mt_

# Object storage (MinIO) — used from stage 4b (file uploads)
# In Docker: host is "minio". For local dev against compose minio, use localhost and MINIO_API_PORT from ../.env
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=mood
MINIO_SECRET_KEY=moodsecret
MINIO_BUCKET=mood-tracker
MINIO_SECURE=false

# Auth / email — used from stage 2
# JWT_SECRET_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
