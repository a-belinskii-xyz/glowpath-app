# Docker Compose — host ports (left side of the mapping).
# Change these if a port is already in use on your machine.
# Container-internal ports stay fixed.
# Local Compose runs Postgres and MinIO. Hosted database and object storage
# belong in .env.prod (see .env.prod.example), not here.

POSTGRES_PORT=5432
APP_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
TELEGRAM_BOT_PORT=8081
