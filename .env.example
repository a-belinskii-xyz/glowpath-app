# Docker Compose — host ports (left side of the mapping).
# Change these if a port is already in use on your machine.
# Container-internal ports stay fixed.
#
# Postgres is not a container. Put the Neon (or other) URL here.
# postgresql:// is rewritten to postgresql+psycopg:// at startup.
# DATABASE_URL_UNPOOLED is the direct host (no -pooler). Alembic uses it when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

POSTGRES_PORT=5432
APP_PORT=8000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
TELEGRAM_BOT_PORT=8081
